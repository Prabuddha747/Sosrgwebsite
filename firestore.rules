rules_version = '2';

// Tracked source of truth for the sosrg-5542c project, referenced by
// docs/PLATFORM_EVOLUTION_PLAN.md. Deployed via
// `firebase deploy --only firestore:rules` — re-run that after any edit
// here, nothing in this repo deploys it automatically.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Talent identity — public read (directory/discovery), owner or admin write.
    // coins/referralCode/isAdmin are server-trusted fields today (no Cloud
    // Functions exist yet to guard them separately) — the real gap flagged
    // in docs/BACKEND_OVERVIEW.md; tightened in a later pass once referral
    // logic moves server-side.
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    match /studioProfiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    // Casting calls — public read only once published; draft calls are
    // visible only to the owning studio so half-finished posts don't leak.
    match /castingCalls/{callId} {
      allow read: if resource.data.status == 'live' || isOwner(resource.data.studioUid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.studioUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.studioUid) || isAdmin();
    }

    // Applications — visible only to the talent who applied and the studio
    // that owns the call; this is applicant PII, never public.
    match /applications/{appId} {
      allow read: if isOwner(resource.data.talentUid) || isOwner(resource.data.studioUid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.talentUid == request.auth.uid;
      allow update: if isOwner(resource.data.studioUid) || isAdmin();
      allow delete: if false;
    }

    // Events — same shape as castingCalls: public once live, draft stays
    // visible only to the organising studio.
    match /events/{eventId} {
      allow read: if resource.data.status == 'live' || isOwner(resource.data.studioUid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.studioUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.studioUid) || isAdmin();
    }

    match /savedTalent/{saveId} {
      allow read, write: if isSignedIn() && saveId.matches(request.auth.uid + '_.*');
    }

    // Existing collections — undocumented before this pass, formalized here.
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Inbox.tsx queries userId `in` [own uid, 'broadcast', 'broadcast_<skill>'...]
    // in one request — Firestore requires every value the query could match
    // to independently satisfy the rule, so broadcast values need their own
    // clause here, not just the ownership check.
    match /notifications/{id} {
      allow read: if isOwner(resource.data.userId)
        || resource.data.userId == 'broadcast'
        || resource.data.userId.matches('^broadcast_.*')
        || isAdmin();
      allow create: if isSignedIn() || isAdmin();
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    match /registrations/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /subscribers/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
